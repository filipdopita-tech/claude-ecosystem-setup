#!/usr/bin/env bash
# agent-budget-tracker.sh.template — PostToolUse hook for auto-tracking Agent invocations.
# Pattern 3 z ruflo-extracted-patterns.md.
#
# OPT-IN INSTALL (NOT auto-enabled — Filip review first):
#   1. Review this template
#   2. Copy: cp ~/.claude/hooks/agent-budget-tracker.sh.template ~/.claude/hooks/agent-budget-tracker.sh
#   3. chmod +x ~/.claude/hooks/agent-budget-tracker.sh
#   4. Wire v ~/.claude/settings.json (use update-config skill):
#      "hooks": {
#        "PostToolUse": [
#          { "matcher": "Agent", "command": "~/.claude/hooks/agent-budget-tracker.sh" }
#        ]
#      }
#
# Hook receives JSON via stdin (PostToolUse contract):
#   { "tool_name": "Agent", "tool_input": {...}, "tool_response": {...} }
#
# Extracts: subagent_type → agent name, description → skill hint, usage tokens
# Logs to: ~/.claude/logs/agent-token-usage.jsonl via agent-budget-track.sh

set -euo pipefail

HOOK_LOG="${HOME}/.claude/logs/agent-budget-hook.log"
TRACK_SCRIPT="${HOME}/scripts/automation/agent-budget-track.sh"

# Disable via env var
if [[ "${AGENT_BUDGET_HOOK_DISABLED:-0}" == "1" ]]; then
  exit 0
fi

# Read stdin — PostToolUse JSON
INPUT=$(cat)

# Bail silently if not Agent tool (defensive — matcher should already filter)
TOOL_NAME=$(echo "$INPUT" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d.get('tool_name', ''))" 2>/dev/null || echo "")
if [[ "$TOOL_NAME" != "Agent" ]]; then
  exit 0
fi

# Parse fields (defensive — missing fields → defaults)
PARSED=$(python3 - <<'PY' 2>/dev/null
import sys, json
try:
    d = json.loads("""$INPUT""")
except Exception:
    sys.exit(0)
ti = d.get('tool_input', {}) or {}
tr = d.get('tool_response', {}) or {}
agent = ti.get('subagent_type', 'agent-fork')
desc = ti.get('description', '') or ''
# Try to extract skill from description
skill_hint = ''
for kw in ['dd-emitent', 'cold-outreach', 'gstack-', 'agency-', 'ig-', 'gws-']:
    if kw in desc.lower():
        skill_hint = kw.rstrip('-')
        break
# Token usage — varies by tool response shape
usage = tr.get('usage', {}) or tr.get('token_usage', {}) or {}
tokens_in = int(usage.get('input_tokens', 0) or usage.get('prompt_tokens', 0) or 0)
tokens_out = int(usage.get('output_tokens', 0) or usage.get('completion_tokens', 0) or 0)
model = ti.get('model', '') or tr.get('model', 'sonnet')
# Default skip if no token data (some Agent responses don't include usage)
if tokens_in == 0 and tokens_out == 0:
    sys.exit(0)
print(f"{agent}|{skill_hint}|{tokens_in}|{tokens_out}|{model}")
PY
)

if [[ -z "$PARSED" ]]; then
  exit 0
fi

IFS='|' read -r AGENT SKILL TIN TOUT MODEL <<< "$PARSED"

# Track (silent on success, log to hook log on failure)
if ! "$TRACK_SCRIPT" "$AGENT" "$SKILL" "$TIN" "$TOUT" "$MODEL" >/dev/null 2>>"$HOOK_LOG"; then
  echo "[$(date -u +%FT%TZ)] track failed: $AGENT $SKILL $TIN+$TOUT" >> "$HOOK_LOG"
fi

exit 0
